<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        AI Resume Analyzer
    </title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='style.css') }}"
    >

</head>


<body>


<!-- =====================================================
     HERO
====================================================== -->

<main>


<section class="hero">


    <div class="hero-content">

        <span class="badge">
            AI-POWERED CAREER TOOL
        </span>


        <h1>
            Analyze Your Resume
            <span>Smarter</span>
        </h1>


        <p>

            Get an instant resume score,
            ATS readiness analysis, skill detection,
            section analysis and personalized
            improvement recommendations.

        </p>


        <a
            href="#upload"
            class="primary-button"
        >
            Analyze My Resume
        </a>

    </div>


</section>


<!-- =====================================================
     UPLOAD
====================================================== -->

<section
    class="upload-section"
    id="upload"
>


    <div class="section-heading">

        <span class="badge">
            RESUME ANALYSIS
        </span>

        <h2>
            Upload Your Resume
        </h2>

        <p>
            Supported formats: PDF and DOCX
            · Maximum size: 10 MB
        </p>

    </div>


    {% with messages =
        get_flashed_messages()
    %}

        {% if messages %}

            <div class="alert">

                {% for message in messages %}

                    <p>
                        {{ message }}
                    </p>

                {% endfor %}

            </div>

        {% endif %}

    {% endwith %}


    <div class="upload-card">


        <div class="upload-icon">
            📄
