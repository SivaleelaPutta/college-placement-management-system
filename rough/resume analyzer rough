<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Resume Job Matcher</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7fb;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: auto;
        }

        .card {
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #1f2937;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #6b7280;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 25px;
        }

        label {
            display: block;
            font-weight: bold;
            color: #374151;
            margin-bottom: 8px;
        }

        input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            background: #f9fafb;
            cursor: pointer;
        }

        textarea {
            width: 100%;
            min-height: 230px;
            padding: 15px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            resize: vertical;
            font-size: 15px;
            line-height: 1.5;
        }

        textarea:focus,
        input[type="file"]:focus {
            outline: none;
            border-color: #2563eb;
        }

        button {
            width: 100%;
            padding: 14px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        .hint {
            margin-top: 6px;
            color: #6b7280;
            font-size: 13px;
        }

        .flash {
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 7px;
            background: #fee2e2;
            color: #991b1b;
        }

        .home-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #2563eb;
            text-decoration: none;
        }

        .home-link:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="card">

        <h1>AI Resume Job Matcher</h1>

        <p class="subtitle">
            Upload your resume and enter a job description
            to analyze your resume against the job requirements.
        </p>


        <!-- Flash Messages -->

        {% with messages = get_flashed_messages() %}

            {% if messages %}

                {% for message in messages %}

                    <div class="flash">
                        {{ message }}
                    </div>

                {% endfor %}

            {% endif %}

        {% endwith %}


        <!-- FORM -->

        <form
            action="{{ url_for('resume_bp.job_match_page') }}"
            method="POST"
            enctype="multipart/form-data"
        >

            <!-- Resume -->

            <div class="form-group">

                <label for="resume">
                    Upload Resume
                </label>

                <input
                    type="file"
                    id="resume"
                    name="resume"
                    accept=".pdf,.doc,.docx"
                    required
                >

                <p class="hint">
                    Accepted formats: PDF, DOC, DOCX
                </p>

            </div>


            <!-- Job Description -->

            <div class="form-group">

                <label for="job_description">
                    Job Description
                </label>

                <textarea
                    id="job_description"
                    name="job_description"
                    placeholder="Paste the job description here..."
                    required
                ></textarea>

                <p class="hint">
                    Include the required skills, qualifications,
                    experience and responsibilities.
                </p>

            </div>


            <!-- Analyze -->

            <button type="submit">
                Analyze Resume
            </button>

        </form>

    </div>

</div>

</body>
</html>










job result html









<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Job Match Result
    </title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='style.css') }}"
    >

</head>


<body>

<main class="result-page">


<section class="result-header">

    <span class="badge">
        MATCH ANALYSIS COMPLETE
    </span>


    <h1>
        Job Match Result
    </h1>


    <p>
        {{ company_name }}
        ·
        {{ job_title }}
    </p>

</section>


<!-- =====================================================
     MATCH SCORE
====================================================== -->

<section class="match-score-card">


    <div class="match-circle">

        <strong>
            {{ result.match_percentage }}%
        </strong>

        <span>
            Match
        </span>

    </div>


    <div>

        <span class="badge">
            {{ result.recommendation }}
        </span>


        <h2>
            Resume Compatibility
        </h2>


        <p>
            Your resume has been compared with
            the skills identified in the Job Description.
        </p>

    </div>


</section>


<!-- =====================================================
     SKILLS
====================================================== -->

<section class="result-grid">


    <!-- MATCHED -->

    <div class="result-card">

        <div class="card-heading">

            <h2>
                ✓ Matched Skills
            </h2>

        </div>


        <div class="skill-list">

            {% for skill in
                result.matched_skills %}

                <span class="skill">
                    {{ skill }}
                </span>

            {% else %}

                <p class="empty">
                    No matching skills found.
                </p>

            {% endfor %}

        </div>

    </div>


    <!-- MISSING -->

    <div class="result-card">

        <div class="card-heading">

            <h2>
                ⚠ Missing Skills
            </h2>

        </div>


        <div class="skill-list">

            {% for skill in
                result.missing_skills %}

                <span class="missing-skill">
                    {{ skill }}
                </span>

            {% else %}

                <p class="empty">
                    No missing skills detected.
                </p>

            {% endfor %}

        </div>

    </div>


</section>


<!-- =====================================================
     RECOMMENDATION
====================================================== -->

<section class="result-card">


    <h2>
        🎯 Recommendation
    </h2>


    {% if result.match_percentage >= 80 %}

        <p>
            Your resume is a strong match for this role.
            You can consider applying confidently.
        </p>


    {% elif result.match_percentage >= 60 %}

        <p>
            Your resume is a good match.
            Consider improving the missing skills
            before applying.
        </p>


    {% elif result.match_percentage >= 40 %}

        <p>
            Your resume has some relevant skills,
            but you should strengthen the missing
            technical requirements.
        </p>


    {% else %}

        <p>
            Your resume currently has limited overlap
            with this Job Description. Consider
            developing the missing skills.
        </p>

    {% endif %}


</section>


<section class="result-actions">

    <a
        href="/job-match"
        class="primary-button"
    >
        Check Another Job
    </a>


    <a
        href="/"
        class="secondary-button"
    >
        Analyze Resume
    </a>

</section>


</main>


</body>

</html>









