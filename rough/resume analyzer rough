style css

/* ==========================================================
   GLOBAL
========================================================== */

* {
    box-sizing: border-box;
}


body {

    margin: 0;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background: #f6f8fc;

    color: #172033;

}


a {
    text-decoration: none;
}

/* ==========================================================
   HERO
========================================================== */

.hero {

    min-height: 450px;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 70px 20px;

    background:
        linear-gradient(
            135deg,
            #eff6ff,
            #ffffff
        );

}


.hero-content {

    max-width: 800px;

}


.hero h1 {

    font-size: 55px;

    line-height: 1.1;

    margin: 20px 0;

}


.hero h1 span {

    color: #2563eb;

}


.hero p {

    color: #64748b;

    font-size: 18px;

    line-height: 1.7;

    max-width: 700px;

    margin:
        0 auto 30px;

}


/* ==========================================================
   BADGE
========================================================== */

.badge {

    display: inline-block;

    padding:
        7px 12px;

    border-radius: 20px;

    background: #dbeafe;

    color: #1d4ed8;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: .8px;

}


/* ==========================================================
   BUTTONS
========================================================== */

.primary-button {

    display: inline-block;

    border: none;

    border-radius: 8px;

    padding:
        13px 22px;

    background: #2563eb;

    color: white;

    font-weight: 700;

    cursor: pointer;

    font-size: 14px;

}


.primary-button:hover {

    background: #1d4ed8;

}


.secondary-button {

    display: inline-block;

    border-radius: 8px;

    padding:
        13px 22px;

    background: #eef2f7;

    color: #172033;

    font-weight: 700;

    font-size: 14px;

}


.full-button {

    width: 100%;

    margin-top: 20px;

}


/* ==========================================================
   UPLOAD SECTION
========================================================== */

.upload-section {

    max-width: 900px;

    margin:
        70px auto;

    padding:
        0 20px;

}


.section-heading {

    text-align: center;

    margin-bottom: 30px;

}


.section-heading h2 {

    font-size: 32px;

    margin:
        12px 0;

}


.section-heading p {

    color: #64748b;

}


/* ==========================================================
   UPLOAD CARD
========================================================== */

.upload-card {

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 18px;

    padding: 50px;

    text-align: center;

    box-shadow:
        0 10px 30px
        rgba(15, 23, 42, .05);

}


.upload-icon {

    font-size: 55px;

    margin-bottom: 10px;

}


.upload-card h3 {

    font-size: 24px;

}


.upload-card p {

    color: #64748b;

    margin-bottom: 30px;

}


.upload-card form {

    max-width: 500px;

    margin: auto;

}


.file-label {

    display: block;

    border:
        2px dashed #cbd5e1;

    border-radius: 10px;

    padding: 25px;

    color: #2563eb;

    font-weight: 700;

    cursor: pointer;

}


.file-label:hover {

    background: #eff6ff;

}


input[type="file"] {

    display: none;

}


.file-name {

    margin-top: 15px;

    color: #64748b;

    font-size: 14px;

}


/* ==========================================================
   FEATURES
========================================================== */

.features {

    max-width: 1100px;

    margin:
        80px auto;

    padding:
        0 20px;

}


.feature-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;

}


.feature-card {

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 14px;

    padding: 25px;

}


.feature-icon {

    font-size: 32px;

}


.feature-card h3 {

    margin-bottom: 8px;

}


.feature-card p {

    color: #64748b;

    line-height: 1.6;

    font-size: 14px;

}


/* ==========================================================
   FOOTER
========================================================== */

footer {

    text-align: center;

    padding: 30px;

    color: #64748b;

    border-top:
        1px solid #e2e8f0;

}


/* ==========================================================
   RESULT PAGE
========================================================== */

.result-page {

    max-width: 1100px;

    margin:
        50px auto;

    padding:
        0 20px;

}


.result-header {

    text-align: center;

    margin-bottom: 35px;

}


.result-header h1 {

    font-size: 38px;

    margin:
        15px 0 8px;

}


.result-header p {

    color: #64748b;

}


/* ==========================================================
   SUMMARY
========================================================== */

.summary-card {

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 16px;

    padding: 30px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 30px;

    margin-bottom: 20px;

}


.summary-card p {

    color: #64748b;

    line-height: 1.7;

}


.main-score {

    min-width: 150px;

    text-align: center;

}


.main-score span {

    display: block;

    color: #64748b;

    font-size: 13px;

}


.main-score strong {

    display: block;

    font-size: 55px;

    color: #2563eb;

}


.main-score small {

    color: #64748b;

}


/* ==========================================================
   SCORE GRID
========================================================== */

.score-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;

    margin-bottom: 20px;

}


.score-card {

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 14px;

    padding: 25px;

}


.score-card span {

    color: #64748b;

    font-size: 14px;

}


.score-card strong {

    display: block;

    font-size: 32px;

    margin:
        8px 0;

    color: #2563eb;

}


.score-card small {

    color: #94a3b8;

}


/* ==========================================================
   RESULT GRID
========================================================== */

.result-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 20px;

    margin-bottom: 20px;

}


.result-card {

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 14px;

    padding: 25px;

}


.card-heading {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 20px;

}


.card-heading h2 {

    margin: 0;

    font-size: 20px;

}


/* ==========================================================
   SKILLS
========================================================== */

.skill-list {

    display: flex;

    flex-wrap: wrap;

    gap: 9px;

}


.skill {

    background: #e0ecff;

    color: #1d4ed8;

    border-radius: 20px;

    padding:
        8px 12px;

    font-size: 13px;

    font-weight: 600;

}


.missing-skill {

    background: #fff1f2;

    color: #be123c;

    border-radius: 20px;

    padding:
        8px 12px;

    font-size: 13px;

    font-weight: 600;

}


/* ==========================================================
   SECTION STATUS
========================================================== */

.section-row {

    display: flex;

    justify-content: space-between;

    padding:
        13px 0;

    border-bottom:
        1px solid #eef2f7;

    font-size: 14px;

}


.present {

    color: #15803d;

    font-weight: 700;

}


.missing {

    color: #d97706;

    font-weight: 700;

}


/* ==========================================================
   SUGGESTIONS
========================================================== */

.suggestions-card {

    margin-bottom: 20px;

}


.suggestion {

    display: flex;

    gap: 15px;

    padding: 15px;

    background: #f8fafc;

    border-radius: 10px;

    margin-bottom: 10px;

}


.suggestion-number {

    min-width: 30px;

    height: 30px;

    border-radius: 50%;

    background: #dbeafe;

    color: #2563eb;

    display: flex;

    align-items: center;

    justify-content: center;

    font-weight: 800;

}


.suggestion p {

    margin: 5px 0;

    line-height: 1.5;

}


/* ==========================================================
   ACTIONS
========================================================== */

.result-actions {

    display: flex;

    justify-content: center;

    gap: 12px;

    margin:
        30px 0;

}


/* ==========================================================
   JOB FORM
========================================================== */

.job-form-card {

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 16px;

    padding: 35px;

}


.job-form-card form {

    display: flex;

    flex-direction: column;

}


.job-form-card label {

    margin-bottom: 7px;

    font-size: 14px;

    font-weight: 700;

}


.job-form-card input[type="text"],
.job-form-card textarea {

    padding: 13px;

    border:
        1px solid #cbd5e1;

    border-radius: 8px;

    margin-bottom: 20px;

    font-family: inherit;

    font-size: 14px;

}


.job-form-card textarea {

    resize: vertical;

}


/* ==========================================================
   MATCH SCORE
========================================================== */

.match-score-card {

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 16px;

    padding: 35px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 40px;

    margin-bottom: 20px;

}


.match-circle {

    width: 180px;

    height: 180px;

    border-radius: 50%;

    background: #eff6ff;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

}


.match-circle strong {

    font-size: 42px;

    color: #2563eb;

}


.match-circle span {

    color: #64748b;

}


/* ==========================================================
   ALERT
========================================================== */

.alert {

    background: #fff7ed;

    border:
        1px solid #fed7aa;

    color: #9a3412;

    border-radius: 8px;

    padding: 10px 15px;

    margin-bottom: 20px;

}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 850px) {

    .feature-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }


    .score-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }


    .result-grid {

        grid-template-columns:
            1fr;

    }

}


@media (max-width: 600px) {

    .nav-links {

        display: none;

    }


    .hero h1 {

        font-size: 38px;

    }


    .feature-grid {

        grid-template-columns:
            1fr;

    }


    .score-grid {

        grid-template-columns:
            1fr;

    }


    .summary-card {

        flex-direction: column;

        text-align: center;

    }


    .result-actions {

        flex-direction: column;

    }


    .match-score-card {

        flex-direction: column;

        text-align: center;

    }

}










